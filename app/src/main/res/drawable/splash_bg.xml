<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep navy base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1628" />
        </shape>
    </item>
    <!-- Subtle cyan radial glow at centre -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="#1206B6D4"
                android:endColor="#0006B6D4" />
            <size android:width="800dp" android:height="800dp" />
        </shape>
    </item>
</layer-list>
