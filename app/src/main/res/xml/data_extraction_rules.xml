<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 (API 31) and above.

   Backup is switched off entirely via android:allowBackup="false" in the
   manifest, so nothing here is consulted today. These excludes are kept as a
   second line of defence: if backup is ever re-enabled, the session token and
   user profile must still never leave the device.

   Uninstalling the app is the user withdrawing consent to use it. Restoring a
   live auth token on the next install would silently sign them back in.
-->
<data-extraction-rules>

    <!-- Backup to the user's Google account. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="iccc_auth_prefs.xml" />
        <exclude domain="sharedpref" path="subscriptions.xml" />
        <exclude domain="sharedpref" path="channel_sync_state.xml" />
        <exclude domain="sharedpref" path="iccc_alert_prefs.xml" />
    </cloud-backup>

    <!-- Direct device-to-device transfer when the user sets up a new phone.
         The token is still excluded: the new device must sign in on its own. -->
    <device-transfer>
        <exclude domain="sharedpref" path="iccc_auth_prefs.xml" />
    </device-transfer>

</data-extraction-rules>
