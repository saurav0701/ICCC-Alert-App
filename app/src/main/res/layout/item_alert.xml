<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_light"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Row: severity border + content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT SEVERITY BORDER — colored dynamically by adapter -->
            <View
                android:id="@+id/severity_bar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/severity_info"
                android:minHeight="60dp" />

            <!-- Card content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Header row: badge + time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <!-- Colored dot -->
                    <View
                        android:id="@+id/alert_badge"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_background"
                        android:layout_marginEnd="8dp" />

                    <!-- Type abbreviation badge -->
                    <TextView
                        android:id="@+id/alert_type_abbrev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VD"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.04"
                        android:background="@drawable/modern_badge_bg"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Relative timestamp -->
                    <TextView
                        android:id="@+id/alert_timestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Just now"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary" />

                </LinearLayout>

                <!-- Event type (title) -->
                <TextView
                    android:id="@+id/alert_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vehicle Detection"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="5dp" />

                <!-- Area row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_area"
                        android:tint="@color/text_tertiary"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="Area" />

                    <TextView
                        android:id="@+id/alert_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sijua"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Location row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_location"
                        android:tint="@color/text_tertiary"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="Location" />

                    <TextView
                        android:id="@+id/alert_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gate 1"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
