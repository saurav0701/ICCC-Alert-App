<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_light"
        app:strokeWidth="0dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/event_accent_bar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/navy_600" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/image_frame"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@color/navy_700">

                    <ImageView
                        android:id="@+id/event_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Event snapshot" />

                    <LinearLayout
                        android:id="@+id/loading_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible"
                        android:background="@drawable/image_loading_gradient">

                        <ProgressBar
                            android:id="@+id/image_progress"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#06B6D4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading image…"
                            android:textSize="12sp"
                            android:textColor="#BAE6FD"
                            android:layout_marginTop="10dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/error_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="@color/navy_700">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_image_error"
                            android:tint="#BAE6FD"
                            android:contentDescription="Failed to load" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Image unavailable"
                            android:textSize="12sp"
                            android:textColor="#BAE6FD"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/image_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/image_gradient_overlay"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_margin="10dp"
                        android:background="@drawable/modern_badge_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:elevation="4dp">

                        <View
                            android:id="@+id/event_badge"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/circle_background"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/event_icon_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VD"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/quick_actions_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:alpha="0">

                        <ImageButton
                            android:id="@+id/quick_save_button"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_bookmark"
                            android:background="@drawable/quick_action_button_bg"
                            android:tint="@color/white"
                            android:layout_marginEnd="8dp"
                            android:elevation="4dp"
                            android:contentDescription="Quick save" />

                        <ImageButton
                            android:id="@+id/quick_share_button"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_share"
                            android:background="@drawable/quick_action_button_bg"
                            android:tint="@color/white"
                            android:elevation="4dp"
                            android:contentDescription="Quick share" />

                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/event_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vehicle Detection"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="5dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_location"
                            android:tint="@color/navy_500"
                            android:contentDescription="Location" />

                        <TextView
                            android:id="@+id/event_location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gate 1"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="5dp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerLight"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/text_tertiary"
                            android:contentDescription="Date" />

                        <TextView
                            android:id="@+id/event_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nov 12, 2025"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="5dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@color/navy_50"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:src="@drawable/ic_time"
                                android:tint="@color/navy_600"
                                android:contentDescription="Time" />

                            <TextView
                                android:id="@+id/event_timestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:32"
                                android:textSize="12sp"
                                android:textColor="@color/navy_600"
                                android:textStyle="bold"
                                android:layout_marginStart="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/navy_50"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_event_button"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Save"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/navy_700"
                        app:icon="@drawable/ic_bookmark"
                        app:iconSize="14dp"
                        style="@style/Widget.Material3.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/more_actions_button"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="More"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/surface_light"
                        app:strokeColor="@color/navy_100"
                        app:strokeWidth="1dp"
                        android:textColor="@color/navy_700"
                        app:icon="@drawable/ic_more"
                        app:iconSize="14dp"
                        app:iconTint="@color/navy_600"
                        style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/save_priority_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@color/navy_50"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Event with Priority"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRIORITY LEVEL"
                        android:textSize="10sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="5dp" />

                    <Spinner
                        android:id="@+id/priority_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADD NOTE (OPTIONAL)"
                        android:textSize="10sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="5dp" />

                    <EditText
                        android:id="@+id/comment_input"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:hint="Add your note here…"
                        android:maxLength="100"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cancel_save_button"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Cancel"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="10dp"
                            app:backgroundTint="@color/surface_light"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp"
                            android:textColor="@color/text_secondary"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/confirm_save_button"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Save Event"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:layout_marginStart="8dp"
                            app:cornerRadius="10dp"
                            app:backgroundTint="@color/navy_700"
                            style="@style/Widget.Material3.Button" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_buttons_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@color/navy_50"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Additional Actions"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/download_image_button"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Download"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="10dp"
                            app:backgroundTint="@color/navy_700"
                            app:icon="@drawable/ic_download"
                            app:iconSize="15dp"
                            style="@style/Widget.Material3.Button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/share_image_button"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Share"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:layout_marginStart="6dp"
                            app:cornerRadius="10dp"
                            app:backgroundTint="@color/navy_700"
                            app:icon="@drawable/ic_share"
                            app:iconSize="15dp"
                            style="@style/Widget.Material3.Button" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/download_event_pdf_button"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:text="Download as PDF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/colorError"
                        app:icon="@drawable/ic_pdf"
                        app:iconSize="15dp"
                        style="@style/Widget.Material3.Button" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
