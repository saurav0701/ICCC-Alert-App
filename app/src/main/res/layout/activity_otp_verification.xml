<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <!-- Top spacer -->
        <Space
            android:id="@+id/top_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/icon_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_weight="1" />

        <!-- Shield / Lock icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_container"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/navy_50"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/navy_100"
            app:layout_constraintTop_toBottomOf="@id/top_spacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_lock"
                android:tint="@color/navy_700"
                android:contentDescription="Security" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enter OTP"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:letterSpacing="-0.01"
            app:layout_constraintTop_toBottomOf="@id/icon_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Phone hint -->
        <TextView
            android:id="@+id/phone_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="OTP sent to your number"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/title_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 6 OTP boxes -->
        <LinearLayout
            android:id="@+id/otp_boxes_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/phone_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/otp_box_1"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/otp_box_2"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/otp_box_3"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/otp_box_4"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/otp_box_5"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/otp_box_6"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:background="@drawable/otp_digit_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textColorHint="@color/text_hint"
                android:hint="·"
                android:importantForAutofill="no"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Timer + Resend -->
        <LinearLayout
            android:id="@+id/resend_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@id/otp_boxes_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend code in 60s"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/resend_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend Code"
                android:textSize="14sp"
                android:textColor="@color/navy_600"
                android:textStyle="bold"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Verify Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verify_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Verify and Continue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:enabled="false"
            android:layout_marginTop="24dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/navy_600"
            app:layout_constraintTop_toBottomOf="@id/resend_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/navy_600"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/verify_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Security notice -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:background="@color/navy_50"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_secure"
                android:tint="@color/navy_600"
                android:layout_marginEnd="6dp"
                android:contentDescription="Secure" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your information is secure and encrypted"
                android:textSize="12sp"
                android:textColor="@color/navy_600" />

        </LinearLayout>

        <!-- Bottom spacer -->
        <Space
            android:id="@+id/bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_weight="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
